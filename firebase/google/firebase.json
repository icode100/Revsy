{
  "hosting": {
    "public": "../../dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/api/**",
        "headers": [{"key": "Cache-Control", "value": "private, no-store"}]
      }
    ],
    "rewrites": [
      {"source": "/api/**", "run": {"serviceId": "revsy-quiz-parser", "region": "us-central1", "pinTag": true}},
      {"source": "**", "destination": "/index.html"}
    ]
  }
}
