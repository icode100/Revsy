# Existing Firebase web configuration (public identifiers, not admin credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Set true only for local development with the demo-revsy emulator project.
VITE_USE_FIREBASE_EMULATORS=false

# Existing note summarizer configuration, if used.
VITE_GOOGLE_API_KEY=

# HTTPS base URL of the deployed quiz worker. Firebase Hosting uses HOSTING_ORIGIN/api.
# Leave empty to disable PDF imports until Firebase prerequisites are deployed.
# Development supports http://localhost:8000. Never put HF_TOKEN/admin credentials in VITE_*.
VITE_QUIZ_PARSER_URL=
# Gemini: 200 question-paper pages, 30 separate key pages, 25 MB per file.
# Legacy zerogpu allows 2 pages total; full allows 30 pages per file.
VITE_QUIZ_PARSER_MODE=gemini
