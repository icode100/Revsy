# Copy to .env.deploy.local (Git-ignored). Local servers and legacy deployment helpers read this file.
# Keep server credentials out of VITE_* variables. Never paste credentials into chat.

# Hugging Face deployment token with Write access to create/update your Spaces.
HF_TOKEN=
# Only for the larger-paper Docker alternative: a separate fine-grained token
# with "Make calls to Inference Providers". Free ZeroGPU does not use this field.
# For Docker, if empty, HF_TOKEN must also allow provider inference.
HF_INFERENCE_TOKEN=

HF_NAMESPACE=icode100
# Exact HTTPS origin, with no page path: e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=
FIREBASE_PROJECT_ID=revsy-c66e0
# Verify this exact bucket name in Firebase Storage before deployment.
FIREBASE_STORAGE_BUCKET=revsy-c66e0.firebasestorage.app
# Full path to downloaded Firebase Admin JSON OUTSIDE the repository.
# Example: C:/secure/revsy-firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_FILE=

# Google/Firebase full-paper parser. Server-side only; never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
QUIZ_PARSER_PROVIDER=gemini
